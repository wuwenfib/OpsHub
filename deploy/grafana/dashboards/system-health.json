{
  "uid": "opshub-system-health",
  "title": "系统健康总览",
  "tags": ["opshub"],
  "timezone": "Asia/Shanghai",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "system",
        "label": "业务系统",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up, system)", "refId": "system" },
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "探活状态",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "min(probe_success{system=~\"$system\"})" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2, "type": "stat", "title": "故障注入模式",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(gov_app_chaos_mode{system=~\"$system\"})" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "正常", "color": "green" },
            "1": { "text": "变慢", "color": "orange" },
            "2": { "text": "报错", "color": "red" } } }],
          "noValue": "无数据（服务已停）"
        }
      }
    },
    {
      "id": 3, "type": "stat", "title": "活动告警数",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\", system=~\"$system\"}) or vector(0)" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] }
        }
      }
    },
    {
      "id": 4, "type": "stat", "title": "MySQL 状态",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "min(mysql_up{system=~\"$system\"})" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        }
      }
    },
    {
      "id": 5, "type": "timeseries", "title": "请求量 QPS（按状态码）",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (code) (rate(http_requests_total{system=~\"$system\"}[1m]))", "legendFormat": "{{code}}" }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "200" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "500" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 6, "type": "timeseries", "title": "错误率（告警阈值 5%）",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{system}}",
        "expr": "(sum by (system) (rate(http_requests_total{system=~\"$system\", code=~\"5..\"}[1m])) or sum by (system) (rate(http_requests_total{system=~\"$system\"}[1m])) * 0) / sum by (system) (rate(http_requests_total{system=~\"$system\"}[1m]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line+area" } },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "transparent" }, { "value": 0.05, "color": "red" }] }
        }
      }
    },
    {
      "id": 7, "type": "timeseries", "title": "P95 延迟（告警阈值 1s）",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{system}}",
        "expr": "histogram_quantile(0.95, sum by (system, le) (rate(http_request_duration_seconds_bucket{system=~\"$system\"}[1m])))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line+area" } },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "transparent" }, { "value": 1, "color": "red" }] }
        }
      }
    },
    {
      "id": 8, "type": "timeseries", "title": "主机 CPU 使用率（告警阈值 85%）",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{instance}}",
        "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{system=~\"$system\", mode=\"idle\"}[1m]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "transparent" }, { "value": 0.85, "color": "red" }] }
        }
      }
    },
    {
      "id": 9, "type": "timeseries", "title": "主机内存使用率",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{instance}}",
        "expr": "1 - node_memory_MemAvailable_bytes{system=~\"$system\"} / node_memory_MemTotal_bytes{system=~\"$system\"}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    }
  ]
}
